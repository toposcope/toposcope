# Packaged (`docker compose up -d`): fill every empty value.
# Demo values `toposcope` / `toposcope-ingest` are refused.
#
#   cp .env.example .env
#   openssl rand -hex 32   # a different one for each variable below
#
# The README quick start writes all three without printing them.

CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
TOPOSCOPE_PASSWORD=
TOPOSCOPE_INGEST_TOKEN=

# Optional: the address people open Toposcope at, behind your reverse proxy,
# so an alert's webhook can link back to the search that fired.
# TOPOSCOPE_PUBLIC_URL=https://toposcope.example.com

# Optional: who watches Toposcope. After each monitor pass it GETs this URL,
# or <url>/fail when it could not read its stores; when the pings stop, the
# service there pages. Healthchecks.io, a Better Stack heartbeat, a push monitor.
# TOPOSCOPE_WATCHDOG_URL=https://hc-ping.com/your-check-uuid

# On by default: once a day Toposcope asks GitHub's public releases list whether a
# newer release is out, and sends nothing about this instance. off makes no call.
# TOPOSCOPE_UPDATE_CHECK=off

# Local `bun run dev` only (compose.dev.yml). Not used by packaged compose.yml.
# HOST=127.0.0.1
# PORT=8080
# CLICKHOUSE_URL=http://127.0.0.1:8123
# SQLITE_PATH=./data/toposcope.sqlite
# TOPOSCOPE_URL=http://127.0.0.1:8080
# SYSLOG_UDP_PORT=5514
# OTLP_GRPC_PORT=4319

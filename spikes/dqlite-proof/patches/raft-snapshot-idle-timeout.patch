+// DefaultSnapshotIdleTimeout is the default NetworkTransportConfig.SnapshotIdleTimeout.
+const DefaultSnapshotIdleTimeout = 5 * time.Second
+
+// idleReader reads an incoming snapshot stream, failing any read that waits
+// longer than idle for data. The first failure is sticky, so the caller's
+// drain of the rest of the stream returns at once instead of waiting again.
+type idleReader struct {
+	conn net.Conn
+	r    io.Reader
+	idle time.Duration
+	err  error
+}
+
+func (ir *idleReader) Read(p []byte) (int, error) {
+	if ir.err != nil {
+		return 0, ir.err
+	}
+	if err := ir.conn.SetReadDeadline(time.Now().Add(ir.idle)); err != nil {
+		ir.err = err
+		return 0, err
+	}
+	n, err := ir.r.Read(p)
+	if err != nil && err != io.EOF {
+		ir.err = err
+	}
+	return n, err
+}
diff --git a/net_transport_snapshot_idle_test.go b/net_transport_snapshot_idle_test.go
new file mode 100644
index 0000000..a3c1960
--- /dev/null
+++ b/net_transport_snapshot_idle_test.go
@@ -0,0 +1,142 @@
+package raft
+
+import (
+	"bufio"
+	"bytes"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/hashicorp/go-hclog"
+	"github.com/hashicorp/go-msgpack/v2/codec"
+)
+
+// A leader lost part way through sending a snapshot (paused, partitioned,
+// or gone without a reset) must not block the follower's install forever.
+func TestNetworkTransport_SnapshotIdleTimeout(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		idle    time.Duration
+		stalled bool
+	}{
+		{"stalled stream is abandoned", 200 * time.Millisecond, true},
+		{"complete stream is read and the connection reused", 200 * time.Millisecond, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			trans, err := NewTCPTransportWithConfig("127.0.0.1:0", nil, &NetworkTransportConfig{
+				MaxPool: 2, Timeout: time.Second, SnapshotIdleTimeout: tc.idle,
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer trans.Close()
+
+			conn, err := net.Dial("tcp", string(trans.LocalAddr()))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn.Close()
+			w := bufio.NewWriter(conn)
+			enc := codec.NewEncoder(w, &codec.MsgpackHandle{})
+			const size = 1 << 20
+			sent := size
+			if tc.stalled {
+				sent = 4096
+			}
+			_ = w.WriteByte(rpcInstallSnapshot)
+			if err := enc.Encode(&InstallSnapshotRequest{
+				RPCHeader: RPCHeader{ProtocolVersion: ProtocolVersionMax}, SnapshotVersion: SnapshotVersionMax,
+				Term: 1, Leader: []byte("leader"), LastLogIndex: 10, LastLogTerm: 1, Size: size,
+			}); err != nil {
+				t.Fatal(err)
+			}
+			_, _ = w.Write(make([]byte, sent))
+			_ = w.Flush()
+
+			var rpc RPC
+			select {
+			case rpc = <-trans.Consumer():
+			case <-time.After(2 * time.Second):
+				t.Fatal("no rpc")
+			}
+			start := time.Now()
+			n, copyErr := io.Copy(io.Discard, rpc.Reader)
+			took := time.Since(start)
+			if tc.stalled {
+				if copyErr == nil || n != int64(sent) {
+					t.Fatalf("read %d bytes, err %v; want %d and a timeout", n, copyErr, sent)
+				}
+				if took < tc.idle || took > tc.idle+time.Second {
+					t.Fatalf("gave up after %v, want about %v", took, tc.idle)
+				}
+				// The drain raft does after a failed install returns at once.
+				start = time.Now()
+				if _, err := io.Copy(io.Discard, rpc.Reader); err == nil || time.Since(start) > 50*time.Millisecond {
+					t.Fatalf("second read: err %v after %v", err, time.Since(start))
+				}
+			} else if copyErr != nil || n != size {
+				t.Fatalf("read %d bytes, err %v; want %d", n, copyErr, size)
+			}
+			rpc.Respond(&InstallSnapshotResponse{Term: 1, Success: !tc.stalled}, nil)
+
+			// The response arrives either way.
+			r := bufio.NewReader(conn)
+			dec := codec.NewDecoder(r, &codec.MsgpackHandle{})
+			_ = conn.SetReadDeadline(time.Now().Add(2 * time.Second))
+			var rpcErr string
+			var resp InstallSnapshotResponse
+			if err := dec.Decode(&rpcErr); err != nil {
+				t.Fatal(err)
+			}
+			if err := dec.Decode(&resp); err != nil {
+				t.Fatal(err)
+			}
+			// Abandoned: the connection is closed, since unread snapshot
+			// bytes are still on it. Complete: it carries the next command
+			// even after waiting longer than the idle timeout.
+			time.Sleep(2 * tc.idle)
+			if tc.stalled {
+				if _, err := r.ReadByte(); err != io.EOF {
+					t.Fatalf("connection still open: %v", err)
+				}
+				return
+			}
+			_ = w.WriteByte(rpcTimeoutNow)
+			_ = enc.Encode(&TimeoutNowRequest{RPCHeader: RPCHeader{ProtocolVersion: ProtocolVersionMax}})
+			_ = w.Flush()
+			select {
+			case rpc = <-trans.Consumer():
+				rpc.Respond(&TimeoutNowResponse{}, nil)
+			case <-time.After(2 * time.Second):
+				t.Fatal("connection not reused after a complete snapshot")
+			}
+		})
+	}
+}
+
+// A candidate sent a snapshot by a leader of its own term becomes its
+// follower, as it would for AppendEntries.
+func TestRaft_InstallSnapshot_CandidateSameTermStepsDown(t *testing.T) {
+	_, transport := NewInmemTransport("")
+	store := NewInmemStore()
+	r := &Raft{trans: transport, logger: hclog.New(nil), stable: store}
+	r.setCurrentTerm(5)
+	r.setState(Candidate)
+
+	// Snapshot version 0 carries Peers, which fail to decode after the term
+	// check, so nothing is read or installed.
+	req := &InstallSnapshotRequest{
+		RPCHeader: RPCHeader{ID: []byte("n3"), Addr: []byte("n3")},
+		Term:      5, Peers: []byte("invalid msgpack"),
+	}
+	chResp := make(chan RPCResponse, 1)
+	r.installSnapshot(RPC{Reader: new(bytes.Buffer), RespChan: chResp}, req)
+	<-chResp
+	if r.getState() != Follower {
+		t.Fatalf("state %v, want Follower", r.getState())
+	}
+	if addr, id := r.LeaderWithID(); id != "n3" || addr == "" {
+		t.Fatalf("leader %q %q, want n3", addr, id)
+	}
+}
